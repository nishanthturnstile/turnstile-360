{
  "name": "@thaarei/thaarei-control-plane",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 23600",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test test/*.test.ts",
    "test:integration": "node ../../scripts/test-control-plane.mjs",
    "auth:generate": "auth generate --config src/server/auth.cli.ts --output src/server/auth.generated.ts --yes",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --conditions=react-server src/server/migrate.ts",
    "staff:operator": "node --conditions=react-server src/server/operator.ts",
    "machine:operator": "node --conditions=react-server src/server/machine-operator.ts",
    "reports:prune": "node src/server/report-maintenance.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "better-auth": "1.7.14",
    "@better-auth/drizzle-adapter": "1.7.14",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "nodemailer": "10.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "@thaarei/control-plane-contracts": "workspace:*",
    "@thaarei/deployment-control": "workspace:*",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "@types/node": "24.19.2",
    "@types/pg": "8.20.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.16.1",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    ".next",
    "public",
    "src/server",
    "database",
    "next.config.ts",
    "src/contracts"
  ]
}
