# Central-only environment. Runtime URL must use control_plane_runtime in its own database.
# Do not launch this central environment alongside the active customer stack on this host.
CONTROL_PLANE_PROFILE=production
CONTROL_PLANE_PUBLIC_ORIGIN=https://control.thaarei.example
CONTROL_PLANE_DATABASE_URL=postgresql://control_plane_runtime:REPLACE@postgres:5432/thaarei_control_plane
CONTROL_PLANE_AUTH_SECRET_FILE=/run/secrets/control-plane-auth
CONTROL_PLANE_SIGNING_KEY_FILE=/run/secrets/control-plane-signing
# Independent host marker outside all database restore sets.
CONTROL_PLANE_RECOVERY_MARKER_FILE=/run/secrets/control-plane-recovery
CONTROL_PLANE_SMTP_URL=smtps://REPLACE:REPLACE@smtp.example:465
CONTROL_PLANE_SMTP_FROM=control@thaarei.example
# true only behind an exclusive ingress that overwrites X-Forwarded-For with ONE address.
CONTROL_PLANE_TRUST_PROXY=false

# Optional module catalogue intake: separate release PUBLIC verification trust JSON.
# Compose: apply compose.control-plane-modules.yaml and set
# CONTROL_PLANE_MODULE_RELEASE_TRUST_HOST_FILE to the owning absolute host file.
# Direct runtime: CONTROL_PLANE_MODULE_RELEASE_TRUST_FILE=/run/module-release-trust.json

# Private machine:operator only: CONTROL_PLANE_MIGRATION_DATABASE_URL and
# CONTROL_PLANE_PUBLIC_KEYS_OUTPUT_FILE (new absolute public-output path).

# Optional exact version allowlists (JSON arrays, max 20); empty means unconfigured.
CONTROL_PLANE_DMS_SUPPORTED_VERSIONS=[]
CONTROL_PLANE_TURNSTILE_SUPPORTED_VERSIONS=[]
# Private reports:prune uses CONTROL_PLANE_MIGRATION_DATABASE_URL (owning migrator).

# Optional read-only verified local-bundle descriptors; contains no images or credentials.
CONTROL_PLANE_MODULE_REFERENCE_DIRECTORY=
