{
  "name": "@thaarei/turnstile-api",
  "version": "0.0.0",
  "description": "Turnstile 360 application API",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.e2e.ts",
    "db:migrate:turnstile": "node --env-file-if-exists=.env.migrate dist/infrastructure/database/migrate.js turnstile",
    "db:bootstrap": "node --env-file-if-exists=.env.migrate dist/infrastructure/database/migrate.js bootstrap",
    "auth:set-access": "node --env-file-if-exists=.env.migrate dist/modules/auth/set-user-access.js",
    "access:operator": "node --env-file-if-exists=.env.migrate dist/modules/access/access-operator.js",
    "access:release": "node --env-file-if-exists=.env --env-file-if-exists=.env.migrate dist/modules/access/release-operator.js",
    "setup:initialize": "node --env-file-if-exists=.env.migrate dist/modules/organization/configuration-operator.js initialize",
    "setup:verify-installation": "node --env-file-if-exists=.env.migrate dist/modules/organization/configuration-operator.js verify-installation",
    "configuration:inspect": "node --env-file-if-exists=.env.migrate dist/modules/organization/configuration-operator.js inspect",
    "configuration:prune": "node --env-file-if-exists=.env.migrate dist/modules/organization/configuration-operator.js prune",
    "test:database": "vitest run --config vitest.config.database.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/session": "11.1.6",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@thaarei/dms-client": "workspace:*",
    "@thaarei/dms-contracts": "workspace:*",
    "@thaarei/turnstile-contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@types/node": "24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "vite": "8.0.0",
    "vitest": "4.1.2"
  },
  "files": [
    "dist",
    "database"
  ],
  "author": "Thaarei"
}
