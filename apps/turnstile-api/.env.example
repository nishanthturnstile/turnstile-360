# Local PostgreSQL connections use 127.0.0.1:23603; see architecture.md reserved local ports.
HOST=127.0.0.1
PORT=3002

AUTH_PROFILE=local
AUTH_PUBLIC_ORIGIN=http://localhost:23600
AUTH_ISSUER_URL=http://localhost:23600/identity
AUTH_LOGIN_CALLBACK_URL=http://localhost:23600/api/auth/callback
AUTH_LOGIN_CLIENT_ID=turnstile-web-login
DMS_MACHINE_CLIENT_ID=turnstile-dms-machine
DMS_RESOURCE_URL=http://localhost:23601/v1
DMS_API_URL=http://localhost:23601/v1

# Independently generated values; never put these in VITE_* configuration.
# Client IDs above are configuration names, not provisioned client records.
AUTH_LOGIN_CLIENT_SECRET=
DMS_MACHINE_CLIENT_SECRET=
TURNSTILE_COOKIE_SECRET=
# Exactly 32 random bytes encoded as 64 hexadecimal characters.
TURNSTILE_TOKEN_ENCRYPTION_KEY=
# Turnstile-owned runtime role/database; AUTH-02 creates persistence.
TURNSTILE_DATABASE_URL=

# Match the one installation bootstrapped by the private migration command.
INSTALLATION_TENANT_ID=
INSTALLATION_CUSTOMER_KEY=
TURNSTILE_APPLICATION_ID=
TURNSTILE_DATABASE_POOL_MAX=5
