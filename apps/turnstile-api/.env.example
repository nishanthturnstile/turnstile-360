# Local PostgreSQL connections use 127.0.0.1:23603; see architecture.md reserved local ports.
HOST=127.0.0.1
PORT=3002

AUTH_PROFILE=local
AUTH_PUBLIC_ORIGIN=http://localhost:23600
AUTH_ISSUER_URL=http://localhost:23600/identity
AUTH_LOGIN_CALLBACK_URL=http://localhost:23600/api/auth/callback
AUTH_LOGIN_CLIENT_ID=turnstile-web-login
DMS_MACHINE_CLIENT_ID=turnstile-dms-machine
DMS_RESOURCE_URL=http://localhost:23601/v1
DMS_API_URL=http://localhost:23601/v1

# Independently generated values; never put these in VITE_* configuration.
# Client IDs above are configuration names, not provisioned client records.
AUTH_LOGIN_CLIENT_SECRET=
DMS_MACHINE_CLIENT_SECRET=
TURNSTILE_COOKIE_SECRET=
# Exactly 32 random bytes encoded as 64 hexadecimal characters.
TURNSTILE_TOKEN_ENCRYPTION_KEY=
# Turnstile-owned runtime role/database; AUTH-02 creates persistence.
TURNSTILE_DATABASE_URL=

# Match the one installation bootstrapped by the private migration command.
INSTALLATION_TENANT_ID=
INSTALLATION_CUSTOMER_KEY=
TURNSTILE_APPLICATION_ID=
TURNSTILE_DATABASE_POOL_MAX=5

# UM-I06: optional until privately provisioned; leave both blank to keep the service unavailable.
IDENTITY_SERVICE_CLIENT_ID=
IDENTITY_SERVICE_RESOURCE_URL=
# Product process only. Never configure these in Vite or browser builds.
IDENTITY_SERVICE_CLIENT_SECRET=
IDENTITY_SERVICE_API_URL=

# UM-I07: dedicated product-only secrets. No fallback to existing auth/token keys.
# Generate independently: 32 random bytes as hex, then 32 random bytes as base64url.
TURNSTILE_INVITATION_ENCRYPTION_KEY=
TURNSTILE_INVITATION_RECOVERY_EPOCH=
# Mailpit capture only; production pilot requires STARTTLS and the existing CA overlay.
TURNSTILE_SMTP_HOST=127.0.0.1
TURNSTILE_SMTP_PORT=23604
TURNSTILE_MAIL_FROM=turnstile@localhost.test

# Public verifier settings only. Private reporter SQL/credentials belong to .env.turnstile.reporter.
TURNSTILE_CONTROL_PLANE_ORIGIN=https://control.example.test
TURNSTILE_CONTROL_PLANE_VERIFICATION_KEYS_FILE=/run/turnstile-trust.json
TURNSTILE_CONTROL_PLANE_RECOVERY_MARKER_FILE=/run/turnstile-marker

# Selected images require signed installed release context, also mounted into the reporter.
TURNSTILE_MODULE_RELEASE_FILE=/run/thaarei/module-release.json
TURNSTILE_MODULE_RELEASE_TRUST_FILE=/run/thaarei/module-release-trust.json

# Optional local reductions of signed module authority; no module is enabled by this setting.
TURNSTILE_DISABLED_MODULES=[]
