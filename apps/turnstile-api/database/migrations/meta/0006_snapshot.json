          "name": "audit_revisions",
          "value": "(\"turnstile\".\"configuration_audit\".\"revision_before\" IS NULL OR \"turnstile\".\"configuration_audit\".\"revision_before\" >= 0) AND \"turnstile\".\"configuration_audit\".\"revision_after\" >= 0"
        }
