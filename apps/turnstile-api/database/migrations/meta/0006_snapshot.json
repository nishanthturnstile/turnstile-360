          "value": "(\"turnstile\".\"configuration_audit\".\"action\" = 'access_changed' AND \"turnstile\".\"configuration_audit\".\"actor_kind\" = 'operator' AND \"turnstile\".\"configuration_audit\".\"subject_user_id\" IS NOT NULL AND \"turnstile\".\"configuration_audit\".\"subject_user_id\" ~ '^[A-Za-z0-9_-]{1,200}$') OR (\"turnstile\".\"configuration_audit\".\"action\" <> 'access_changed' AND \"turnstile\".\"configuration_audit\".\"subject_user_id\" IS NULL)"
        },
