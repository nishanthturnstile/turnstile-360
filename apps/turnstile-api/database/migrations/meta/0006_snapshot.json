          "name": "audit_actor_bound",
          "value": "\"turnstile\".\"configuration_audit\".\"actor_kind\" IN ('user', 'operator') AND \"turnstile\".\"configuration_audit\".\"actor_id\" ~ '^[A-Za-z0-9_-]{1,200}$'"
