# Local PostgreSQL connections use 127.0.0.1:23603; see architecture.md reserved local ports.
# Private migration/operator process only. Never provide this file to the API runtime.
AUTH_MIGRATION_DATABASE_URL=
DMS_MIGRATION_DATABASE_URL=
INSTALLATION_TENANT_ID=
INSTALLATION_CUSTOMER_KEY=
# Nonsecret enrollment binding; use the same canonical values as runtime configuration.
AUTH_ISSUER_URL=http://localhost:23600/identity
DMS_RESOURCE_URL=http://localhost:23601/v1

# Private audit inspection only: thaarei_dms_operator. Never inject into API/worker.
DMS_OPERATOR_DATABASE_URL=
# Private outbox/capacity/accounting authority (no dispatcher ships yet).
# thaarei_dms_coordinator; never inject into the API.
DMS_COORDINATOR_DATABASE_URL=
