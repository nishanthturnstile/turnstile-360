{
  "name": "@thaarei/dms-api",
  "version": "0.0.0",
  "description": "Control API for the Thaarei Document Management System",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.api.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.e2e.ts",
    "db:migrate:auth": "node --env-file-if-exists=.env.migrate dist/infrastructure/database/migrate.js auth",
    "db:migrate:dms": "node --env-file-if-exists=.env.migrate dist/infrastructure/database/migrate.js dms",
    "db:bootstrap": "node --env-file-if-exists=.env.migrate dist/infrastructure/database/migrate.js bootstrap",
    "test:database": "vitest run --config vitest.config.database.ts",
    "auth:generate": "auth generate --config src/modules/platform-auth/auth.ts --output src/modules/platform-auth/persistence/auth.generated.ts --yes",
    "auth:check": "auth check schema --config src/modules/platform-auth/auth.ts",
    "auth:provision-user": "node --env-file-if-exists=.env dist/modules/platform-auth/provision-user.js",
    "auth:manage-client": "node --env-file-if-exists=.env dist/modules/platform-auth/manage-client.js",
    "dms:manage-application": "node --env-file-if-exists=.env --env-file-if-exists=.env.migrate dist/modules/enrollment/manage-application.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@thaarei/dms-contracts": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@types/node": "24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.20.0",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "vite": "8.0.0",
    "vitest": "4.1.2"
  },
  "files": [
    "dist",
    "database"
  ],
  "author": "Thaarei"
}
