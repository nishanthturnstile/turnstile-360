HOST=127.0.0.1
PORT=3001

# Local public identity is served through Vite. Production/test profiles are described
# in architecture.md#authentication-configuration-foundations.
AUTH_PROFILE=local
AUTH_PUBLIC_ORIGIN=http://localhost:5173
AUTH_ISSUER_URL=http://localhost:5173/identity
AUTH_LOGIN_CALLBACK_URL=http://localhost:5173/api/auth/callback
DMS_RESOURCE_URL=http://localhost:3001/v1
AUTH_SIGNING_ALGORITHM=RS256
AUTH_LOGIN_CLIENT_ID=turnstile-web-login
DMS_MACHINE_CLIENT_ID=turnstile-dms-machine

# Generate a unique secret; blank values intentionally leave auth unready.
# AUTH_SECRET encrypts authority data, including persisted private signing keys.
AUTH_SECRET=
# Separate runtime roles; AUTH-02 creates roles, schemas and reviewed migrations.
AUTH_DATABASE_URL=
DMS_DATABASE_URL=

# Match the one installation bootstrapped by the private migration command.
INSTALLATION_TENANT_ID=
INSTALLATION_CUSTOMER_KEY=

# Local Mailpit capture, started by pnpm dev:auth; UI is http://localhost:8025.
# Pilot uses deploy/compose.mailpit.yaml with STARTTLS and an operator-provided CA.
# Plain SMTP is allowed only on loopback in local/test profiles.
# A private pilot CA is supplied by the overlay with NODE_EXTRA_CA_CERTS=/run/mailpit/ca.crt.
AUTH_SMTP_HOST=localhost
AUTH_SMTP_PORT=1025
AUTH_SMTP_MODE=plain
AUTH_MAIL_FROM=identity@example.test
# Set both together only if your SMTP relay requires authentication.
# AUTH_SMTP_USER=
# AUTH_SMTP_PASSWORD=
AUTH_DATABASE_POOL_MAX=5
