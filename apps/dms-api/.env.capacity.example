# Private one-off capacity observer. Never load coordinator credentials into public APIs.
DMS_COORDINATOR_DATABASE_URL=
INSTALLATION_TENANT_ID=
INSTALLATION_CUSTOMER_KEY=
# Absolute roots for the ACTUAL storage and worker scratch filesystems, mounted read-only.
DMS_STORAGE_CAPACITY_PATH=/capacity/storage
DMS_SCRATCH_CAPACITY_PATH=/capacity/scratch
# Default conservatively treats both roots as sharing capacity. Set true only when the
# operator has verified physically independent capacity pools; same-device roots remain shared.
DMS_CAPACITY_INDEPENDENT_FILESYSTEMS=false
