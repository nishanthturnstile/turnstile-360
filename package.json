{
  "name": "@thaarei/workspace",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "docker compose up --build --watch",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check": "biome ci . && pnpm check:boundaries && pnpm check:contracts && pnpm typecheck && pnpm check:python && pnpm check:deploy && pnpm check:auth:cli",
    "check:contracts": "turbo run build --filter=@thaarei/turnstile-contracts --filter=@thaarei/dms-contracts && node scripts/generate-turnstile-time-zones.mjs --check && node scripts/generate-turnstile-onboarding-openapi.mjs --check && node scripts/generate-user-management-openapi.mjs --check",
    "check:fix": "biome check --write .",
    "check:boundaries": "turbo run build --filter=@thaarei/dms-contracts --filter=@thaarei/turnstile-contracts --filter=@thaarei/dms-client && depcruise apps/dms-api/src apps/turnstile-api/src apps/turnstile-web/src packages/dms-client/src packages/dms-contracts/src packages/turnstile-contracts/src --config tooling/dependency-rules/config.cjs",
    "check:python": "pnpm --filter @thaarei/dms-processing run check",
    "check:deploy": "node scripts/check-deploy.mjs",
    "test": "node --test scripts/dev-container.test.mjs && turbo run test",
    "test:integration": "turbo run test:integration && pnpm test:database",
    "test:smoke": "node scripts/smoke-runtime.mjs",
    "check:auth:cli": "node scripts/check-auth-cli.mjs",
    "test:database": "node scripts/test-auth-database.mjs",
    "test:browser:auth": "node scripts/test-auth-database.mjs --browser",
    "test:browser:onboarding:structured": "node scripts/test-auth-database.mjs --browser --structured-onboarding",
    "test:images:onboarding": "node scripts/test-onboarding-images.mjs",
    "test:images:user-management": "node scripts/test-user-management-images.mjs",
    "test:upgrade:user-management": "node scripts/test-auth-database.mjs --user-management-release",
    "release:backup:user-management:local": "node scripts/backup-local-user-management.mjs",
    "release:rehearse:user-management:local": "node scripts/rehearse-local-user-management.mjs",
    "release:retire:user-management:local": "node scripts/retire-local-user-management-credentials.mjs",
    "release:verify:user-management:local": "node scripts/verify-local-user-management-release.mjs",
    "release:rehearse:onboarding:local": "node scripts/rehearse-local-onboarding-upgrade.mjs",
    "release:backup:onboarding:local": "node scripts/backup-local-onboarding.mjs",
    "release:verify:onboarding:local": "node scripts/verify-local-onboarding-release.mjs",
    "db:provision": "node --env-file-if-exists=.env.provision scripts/provision-auth-database.mjs",
    "docs:dms-auth": "pnpm --filter @thaarei/dms-contracts build && node scripts/generate-dms-auth-openapi.mjs",
    "docs:turnstile-onboarding": "pnpm --filter @thaarei/turnstile-contracts build && node scripts/generate-turnstile-onboarding-openapi.mjs",
    "docs:user-management": "pnpm --filter @thaarei/turnstile-contracts build && pnpm --filter @thaarei/dms-contracts build && node scripts/generate-user-management-openapi.mjs",
    "generate:turnstile-time-zones": "node scripts/generate-turnstile-time-zones.mjs",
    "test:browser:structure": "node scripts/test-auth-database.mjs --browser --structure-editor",
    "test:browser:people": "node scripts/test-auth-database.mjs --browser --people-ui"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "pg": "8.23.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "description": "Private Thaarei workspace for Turnstile 360 and the Document Management System",
  "author": "Thaarei"
}
