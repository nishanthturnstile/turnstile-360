{
  "type": "module",
  "name": "@thaarei/dms-contracts",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./private": {
      "types": "./dist/private.d.ts",
      "import": "./dist/private.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "description": "Shared API, job, event, and artifact contracts for the Thaarei Document Management System",
  "author": "Thaarei",
  "dependencies": {
    "zod": "4.6.7"
  }
}
