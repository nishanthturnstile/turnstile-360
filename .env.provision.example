# Local PostgreSQL connections use 127.0.0.1:23603; see architecture.md reserved local ports.
# Private operator process for a dedicated installation database. Never load into APIs/web.
# This command refuses existing roles and does not rotate credentials.
# Set DATABASE_PROFILE=dms to require only auth/DMS roles; default is combined.
DATABASE_PROFILE=combined
PROVISION_DATABASE_URL=
# Required usernames: thaarei_{auth,dms,turnstile}_{runtime,migrator}; unique passwords.
AUTH_DATABASE_URL=
DMS_DATABASE_URL=
TURNSTILE_DATABASE_URL=
AUTH_MIGRATION_DATABASE_URL=
DMS_MIGRATION_DATABASE_URL=
TURNSTILE_MIGRATION_DATABASE_URL=

# Optional distinct private roles; omitted URLs create safe NOLOGIN roles.
# Usernames: thaarei_dms_operator / thaarei_dms_coordinator; unique passwords.
DMS_OPERATOR_DATABASE_URL=
DMS_COORDINATOR_DATABASE_URL=
# Existing installation before migration 0006: provision only these two new roles
# using scripts/provision-auth-database.mjs --dms-access-only and a protected env file.
