          "409": {
            "description": "Readiness or access context changed",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "private, no-store" } },
              "Referrer-Policy": { "schema": { "type": "string", "const": "no-referrer" } }
            },
            "content": {
