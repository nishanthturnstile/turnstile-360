{
  "openapi": "3.1.0",
  "info": { "title": "Turnstile module capabilities", "version": "1.0.0" },
  "servers": [{ "url": "https://turnstile.example.test" }],
  "paths": {
    "/api/modules": {
      "get": {
        "description": "Only installed modules permitted by current signed v2, local enablement, current explicit user rights and readiness. Legacy products return no business modules.",
        "security": [{ "ProductSession": [] }],
        "responses": {
          "200": {
            "description": "Current user projection",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "private, no-store" } },
              "Referrer-Policy": { "schema": { "type": "string", "const": "no-referrer" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModuleCapabilities" },
                "example": {
                  "version": 1,
                  "modules": [
                    {
                      "id": "incident-management",
                      "title": "Incident Management",
                      "path": "/modules/incident-management"
                    }
                  ],
                  "context": {
                    "catalogueDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                    "profileDigest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                    "releaseId": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
                    "policyRevision": 3,
                    "assignmentRevision": 2
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "private, no-store" } },
              "Referrer-Policy": { "schema": { "type": "string", "const": "no-referrer" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModuleError" },
                "example": { "code": "MODULE_ACCESS_DENIED" }
              }
            }
          },
          "401": {
            "description": "Normal login required",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "private, no-store" } },
              "Referrer-Policy": { "schema": { "type": "string", "const": "no-referrer" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModuleError" },
                "example": { "code": "MODULE_ACCESS_DENIED" }
              }
            }
          },
          "403": {
            "description": "Deployment or user/module access denied",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "private, no-store" } },
              "Referrer-Policy": { "schema": { "type": "string", "const": "no-referrer" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModuleError" },
                "example": { "code": "MODULE_ACCESS_DENIED" }
              }
            }
          },
          "409": {
            "description": "Readiness or access context changed",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "private, no-store" } },
              "Referrer-Policy": { "schema": { "type": "string", "const": "no-referrer" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModuleError" },
                "example": { "code": "MODULE_ACCESS_DENIED" }
              }
            }
          },
          "503": {
            "description": "Required dependency or release unavailable",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "private, no-store" } },
              "Referrer-Policy": { "schema": { "type": "string", "const": "no-referrer" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ModuleError" },
                "example": { "code": "MODULE_ACCESS_DENIED" }
              }
            }
          }
        }
      }
    },
