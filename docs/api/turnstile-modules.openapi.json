  },
  "components": {
    "securitySchemes": {
      "ProductSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-turnstile",
        "description": "Normal product BFF session. Staff and machine credentials do not authenticate user module routes."
      }
    },
    "schemas": {
      "ModuleCapabilities": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "version": { "type": "number", "const": 1 },
          "modules": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "enum": ["incident-management", "risk-management"] },
                "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                "path": { "type": "string", "maxLength": 100 }
              },
              "required": ["id", "title", "path"],
              "additionalProperties": false
            }
          },
          "context": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "catalogueDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "profileDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "releaseId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "policyRevision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "assignmentRevision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "catalogueDigest",
                  "profileDigest",
                  "releaseId",
                  "policyRevision",
                  "assignmentRevision"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          }
        },
        "required": ["version", "modules", "context"],
        "additionalProperties": false
      },
      "ModuleEntry": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": { "type": "string", "enum": ["incident-management", "risk-management"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "message": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "required": ["id", "title", "message"],
        "additionalProperties": false
      },
      "ModuleError": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "MODULE_ACCESS_DENIED",
              "MODULE_UNAVAILABLE",
              "MODULE_INVALID_INPUT",
              "IDENTITY_REQUIRED",
              "LOGIN_REQUIRED",
              "PRODUCT_ACCESS_DENIED",
              "PERMISSION_DENIED",
              "DEPLOYMENT_RESTRICTED",
              "AUTH_UNAVAILABLE",
              "SETUP_REQUIRED",
              "CONFIGURATION_UNAVAILABLE",
              "REFRESH_IN_PROGRESS",
              "ACCESS_CONTEXT_CHANGED"
            ]
          },
          "requestId": { "type": "string", "maxLength": 128 },
          "accessRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "reason": { "type": "string", "maxLength": 128 }
        },
        "required": ["code"],
        "additionalProperties": false
      }
    }
  }
}
