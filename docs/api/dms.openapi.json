{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Thaarei DMS consumer API",
    "version": "1.2.0",
    "description": "Implemented consumer control routes only. Obtain short-lived machine tokens outside the browser. Identity sessions do not authorize DMS calls. Enrollment is CLI/backend-only; no document or processing feature is advertised before implementation."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/v1/audit": {
      "get": {
        "operationId": "getDmsAudit",
        "summary": "Read own application audit",
        "x-dms-policy": "machine",
        "x-required-scopes": ["dms:audit:read"],
        "x-browser-execution": true,
        "description": "Authorization always uses current registration and scope policy. Cookies and explorer access credentials grant no machine access.",
        "security": [{ "MachineBearer": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": { "type": "string", "maxLength": 2048 },
            "description": "Opaque signed keyset cursor, bound to current tenant/principal/filter; every page reauthorizes."
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded owner-only application audit page; no document resources exist yet.",
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated UUID; untrusted caller IDs are not reflected.",
                "schema": { "$ref": "#/components/schemas/RequestId" },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "description": "Sensitive control responses are never cached.",
                "schema": { "type": "string", "const": "private, no-store" },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuditPage" },
                "example": { "items": [], "nextCursor": null }
              }
            }
          },
          "400": {
            "description": "Controlled DMS error (400). See the finite DmsError codes and retryable flag.",
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated UUID; untrusted caller IDs are not reflected.",
                "schema": { "$ref": "#/components/schemas/RequestId" },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "description": "Sensitive control responses are never cached.",
                "schema": { "type": "string", "const": "private, no-store" },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DmsError" },
                "example": {
                  "code": "INVALID_REQUEST",
                  "requestId": "11111111-1111-4111-8111-111111111111",
                  "retryable": false
                }
              }
            }
          },
          "401": {
            "description": "Controlled DMS error (401). See the finite DmsError codes and retryable flag.",
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated UUID; untrusted caller IDs are not reflected.",
                "schema": { "$ref": "#/components/schemas/RequestId" },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "description": "Sensitive control responses are never cached.",
                "schema": { "type": "string", "const": "private, no-store" },
                "example": "private, no-store"
              },
              "WWW-Authenticate": {
                "schema": { "type": "string", "const": "Bearer realm=\"dms\"" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DmsError" },
                "example": {
                  "code": "MACHINE_TOKEN_REQUIRED",
                  "requestId": "11111111-1111-4111-8111-111111111111",
                  "retryable": false
                }
              }
            }
          },
          "403": {
            "description": "Controlled DMS error (403). See the finite DmsError codes and retryable flag.",
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated UUID; untrusted caller IDs are not reflected.",
                "schema": { "$ref": "#/components/schemas/RequestId" },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "description": "Sensitive control responses are never cached.",
                "schema": { "type": "string", "const": "private, no-store" },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DmsError" },
                "example": {
                  "code": "APPLICATION_DENIED",
                  "requestId": "11111111-1111-4111-8111-111111111111",
                  "retryable": false
                }
              }
            }
          },
          "503": {
            "description": "Controlled DMS error (503). See the finite DmsError codes and retryable flag.",
            "headers": {
              "X-Request-Id": {
