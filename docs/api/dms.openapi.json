  "components": {
    "securitySchemes": {
      "MachineBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "RS256 at+jwt",
        "description": "Backend client-credentials token for the exact DMS audience, lasting at most 300 seconds. Never enter a machine client secret here."
      },
      "EnrollmentKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Thaarei-Enrollment-Key",
        "description": "Private CLI/backend enrollment only. Browser execution is disabled for enrollment."
      }
    },
    "schemas": {
      "EnrollmentRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[\\p{L}\\p{N} ._'()-]+$"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "EnrollmentResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
