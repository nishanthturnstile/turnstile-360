    "/v1/application-enrollments": {
      "post": {
        "operationId": "enrollDmsApplication",
        "summary": "Enroll a privately registered consumer (CLI/backend only)",
        "x-dms-policy": "enrollment",
        "x-required-scopes": [],
        "x-browser-execution": false,
        "description": "Same Idempotency-Key and body replay the same receipt for 24 hours, after reauthorization. Different bodies conflict. Concurrent work returns ENROLLMENT_IN_PROGRESS with Retry-After: 1. A private enrollment key is required only here. Do not enter it in Swagger.",
        "security": [{ "MachineBearer": [], "EnrollmentKey": [] }],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": { "$ref": "#/components/schemas/IdempotencyKey" },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnrollmentRequest" },
              "example": { "name": "Independent backend" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated identical enrollment replay; no reactivation of a disabled consumer.",
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated UUID; untrusted caller IDs are not reflected.",
                "schema": { "$ref": "#/components/schemas/RequestId" },
                "example": "11111111-1111-4111-8111-111111111111"
              },
              "Cache-Control": {
                "description": "Sensitive control responses are never cached.",
                "schema": { "type": "string", "const": "private, no-store" },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnrollmentResponse" },
                "example": {
                  "applicationId": "11111111-1111-4111-8111-111111111111",
                  "tenantId": "22222222-2222-4222-8222-222222222222",
                  "status": "active",
                  "receiptId": "33333333-3333-4333-8333-333333333333",
                  "replayUntil": "2026-11-05T12:00:00Z"
                }
              }
            }
          },
          "201": {
            "description": "Enrollment activation and receipt committed atomically.",
            "headers": {
              "X-Request-Id": {
                "description": "Server-generated UUID; untrusted caller IDs are not reflected.",
                "schema": { "$ref": "#/components/schemas/RequestId" },
