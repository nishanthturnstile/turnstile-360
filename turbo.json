{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tooling/typescript/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "!tests/**", "!**/*.spec.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/fixtures/user-management.mjs",
        "$TURBO_ROOT$/scripts/generate-user-management-openapi.mjs",
        "$TURBO_ROOT$/docs/api/turnstile-people.openapi.json",
        "$TURBO_ROOT$/docs/api/identity-invitations.openapi.json"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@thaarei/thaarei-control-plane#build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_TELEMETRY_DISABLED"],
      "dependsOn": ["^build"]
    },
    "@thaarei/thaarei-control-plane#typecheck": {
      "dependsOn": ["@thaarei/thaarei-control-plane#build"],
      "outputs": []
    },
    "@thaarei/thaarei-control-plane#test:integration": {
      "dependsOn": ["@thaarei/thaarei-control-plane#build"],
      "cache": false,
      "passThroughEnv": [
        "PATH",
        "DOCKER_HOST",
        "DOCKER_CONTEXT",
        "DOCKER_CONFIG",
        "CONTROL_PLANE_TEST_IMAGE",
        "DMS_CONTROL_TEST_IMAGE"
      ]
    }
  }
}
