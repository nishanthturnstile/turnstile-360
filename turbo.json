{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tooling/typescript/**"],
  "tasks": {
    "build": {
      "env": ["VITE_API_BASE_URL"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "!tests/**", "!**/*.spec.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
