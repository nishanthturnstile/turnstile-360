# Private Linux-host configuration for the activated/combined complete entries.
# Keep customer identity/OAuth origins and credentials in their owning existing files.
CONTROL_PLANE_ORIGIN=https://control.thaarei.example
# Filled after central registration; the stored exact binding is authoritative.
CONTROL_PLANE_INSTALLATION_ID=
CONTROL_PLANE_PRODUCT_ID=
CONTROL_PLANE_TRUST_HOST_FILE=/srv/thaarei/deployment/public-trust.json
CONTROL_PLANE_RECOVERY_HOST_FILE=/srv/thaarei/recovery/deployment-marker
CONTROL_PLANE_PRIVATE_HOST_DIRECTORY=/srv/thaarei/deployment/private
# Public CA bundle including customer/central private roots, if applicable.
CUSTOMER_EXTRA_CA_HOST_FILE=/etc/ssl/certs/ca-certificates.crt

# Independent Turnstile pairing, marker and credential directory. Never reuse DMS credentials.
TURNSTILE_CONTROL_PLANE_ORIGIN=https://control.example.test
TURNSTILE_CONTROL_PLANE_TRUST_HOST_FILE=/opt/thaarei/turnstile-control/trust.json
TURNSTILE_CONTROL_PLANE_RECOVERY_HOST_FILE=/opt/thaarei/turnstile-control-marker
TURNSTILE_CONTROL_PLANE_PRIVATE_HOST_DIRECTORY=/opt/thaarei/turnstile-control/private
# Optional registered IDs must agree with the durable owning binding.
TURNSTILE_CONTROL_PLANE_INSTALLATION_ID=
TURNSTILE_CONTROL_PLANE_PRODUCT_ID=
