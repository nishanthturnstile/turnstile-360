# Create four protected files with distinct OAuth and AMQP principals.
# Role: publisher | scanner | extractor | heavy
DMS_WORK_ROLE=scanner
DMS_WORK_CLIENT_ID=
DMS_WORK_CLIENT_SECRET=
DMS_WORK_ISSUER_URL=https://identity.example.invalid/identity
DMS_WORK_TOKEN_URL=http://dms-api:3001/identity/oauth2/token
DMS_WORK_API_URL=http://coordinator:3003/internal/work
# Only the private isolated HTTP/AMQP hops use plaintext. Public issuer/ingress use TLS.
DMS_WORK_ALLOW_HTTP=true
DMS_BROKER_URL=amqp://dms-scanner:replace-in-protected-file@work-broker:5672/dms
