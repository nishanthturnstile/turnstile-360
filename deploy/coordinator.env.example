DMS_WORK_HOST=0.0.0.0
DMS_WORK_PORT=3003
DMS_STORAGE_CAPACITY_PATH=/capacity/storage
DMS_SCRATCH_CAPACITY_PATH=/capacity/scratch
DMS_CAPACITY_INDEPENDENT_FILESYSTEMS=false
DMS_STORAGE_ENDPOINT=http://storage:8333
DMS_STORAGE_PUBLIC_ORIGIN=https://files.example.invalid
DMS_STORAGE_REGION=us-east-1
DMS_STORAGE_PATH_STYLE=true
DMS_STORAGE_ALLOW_HTTP=true
DMS_STORAGE_STAGING_BUCKET=dms-staging
DMS_STORAGE_ORIGINALS_BUCKET=dms-originals
DMS_STORAGE_ARTIFACTS_BUCKET=dms-artifacts
DMS_STORAGE_BROWSER_ORIGINS=[]
DMS_STORAGE_SNAPSHOT_ACCESS_KEY_ID=
DMS_STORAGE_SNAPSHOT_SECRET_ACCESS_KEY=

# I14 input signing and exact artifact output/verification; keep every pair distinct.
DMS_STORAGE_ORIGINAL_READ_ACCESS_KEY_ID=
DMS_STORAGE_ORIGINAL_READ_SECRET_ACCESS_KEY=
DMS_STORAGE_ARTIFACT_WRITE_ACCESS_KEY_ID=
DMS_STORAGE_ARTIFACT_WRITE_SECRET_ACCESS_KEY=
DMS_STORAGE_ARTIFACT_READ_ACCESS_KEY_ID=
DMS_STORAGE_ARTIFACT_READ_SECRET_ACCESS_KEY=

# I19 exact-key cleanup, after durable reference/recovery authorization.
DMS_STORAGE_CLEANUP_ACCESS_KEY_ID=
