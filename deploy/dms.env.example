# Copy to root .env.dms (private); Compose loads only runtime credentials here.
AUTH_MODE=standalone
AUTH_PROFILE=production
AUTH_PUBLIC_ORIGIN=https://dms.customer.example
AUTH_ISSUER_URL=https://dms.customer.example/identity
DMS_RESOURCE_URL=https://dms.customer.example/v1
AUTH_SECRET=
AUTH_DATABASE_URL=
DMS_DATABASE_URL=
INSTALLATION_TENANT_ID=
INSTALLATION_CUSTOMER_KEY=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_MODE=starttls
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=
# Optional explicit server-owned consumer screen policy, no automatic registration.
AUTH_LOGIN_CLIENTS=[]

# Controlled operator explorer only; use a separate generated key, never a machine secret.
DMS_DOCS_MODE=off
DMS_DOCS_ACCESS_KEY=
