{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.agents",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/generated",
      "!!pnpm-lock.yaml",
      "!!skills-lock.json",
      "!!docs/headless_dms_*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/turnstile-web/**/*.css"],
      "css": { "parser": { "tailwindDirectives": true } }
    },
    {
      "includes": ["apps/dms-api/**/*.ts", "apps/turnstile-api/**/*.ts"],
      "javascript": {
        "parser": { "unsafeParameterDecoratorsEnabled": true }
      },
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
